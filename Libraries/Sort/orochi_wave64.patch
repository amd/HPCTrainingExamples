-		u32 leaderIdx = __ffs( broThreads ) - 1;
+		u32 leaderIdx = __ffsll( (unsigned long long)broThreads ) - 1;
 		if( lane == leaderIdx )
 		{
-			smem.u.phase1.lpSum[bucketIndex * REORDER_NUMBER_OF_WARPS + warp] = digitCount + __popc( broThreads );
+			smem.u.phase1.lpSum[bucketIndex * REORDER_NUMBER_OF_WARPS + warp] = digitCount + __popcll( broThreads );
 		}
 #if defined( ITS )
-		__syncwarp( 0xFFFFFFFF );
+		__syncwarp( ~0ull );
 #else
 		__syncthreads();
 #endif
