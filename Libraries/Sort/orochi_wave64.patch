diff --git a/ParallelPrimitives/RadixSortConfigs.h b/ParallelPrimitives/RadixSortConfigs.h
index d06cde5..ae40096 100644
--- a/ParallelPrimitives/RadixSortConfigs.h
+++ b/ParallelPrimitives/RadixSortConfigs.h
@@ -42,7 +42,18 @@ constexpr auto SINGLE_SORT_WG_SIZE{ 128 };
 
 static_assert( BIN_SIZE % 2 == 0 );
 
-constexpr int WARP_SIZE = 32;
+// Wavefront width of the target GPU. RDNA (Radeon workstation/consumer) is 32;
+// CDNA Instinct data-center parts (e.g. MI300A / gfx942) are 64. The Onesweep
+// reorder kernel is wavefront-synchronous, so this MUST match the hardware wave.
+//
+// This header is shared by the host (which sets the kernel launch block size)
+// and the runtime-compiled device kernels, so the value must be identical on
+// both sides -- we cannot key it off a device-only arch macro. Set it for the
+// target GPU here (64 for CDNA Instinct / MI300A). Override with -DWARP_SIZE=32
+// on both host and hiprtc options to build for RDNA wave32.
+#ifndef WARP_SIZE
+#define WARP_SIZE 64
+#endif
 
 constexpr int RADIX_SORT_BLOCK_SIZE = 4096;
 
@@ -53,7 +64,10 @@ constexpr int GHISTOGRAM_ITEMS_PER_THREAD = GHISTOGRAM_ITEM_PER_BLOCK / GHISTOGR
 constexpr int REORDER_NUMBER_OF_WARPS = 8;
 constexpr int REORDER_NUMBER_OF_THREADS_PER_BLOCK = WARP_SIZE * REORDER_NUMBER_OF_WARPS;
 constexpr int REORDER_NUMBER_OF_ITEM_PER_WARP = RADIX_SORT_BLOCK_SIZE / REORDER_NUMBER_OF_WARPS;
-constexpr int REORDER_NUMBER_OF_ITEM_PER_THREAD = REORDER_NUMBER_OF_ITEM_PER_WARP / 32;
+// Items each lane owns = items-per-warp / lanes-per-warp. Must use WARP_SIZE
+// (not a hardcoded 32) so the per-thread arrays and loop trip counts match the
+// wave width -- otherwise wave64 over-allocates and mis-iterates.
+constexpr int REORDER_NUMBER_OF_ITEM_PER_THREAD = REORDER_NUMBER_OF_ITEM_PER_WARP / WARP_SIZE;
 
 constexpr int LOOKBACK_TABLE_SIZE = 1024;
 constexpr int MAX_LOOK_BACK = 64;
