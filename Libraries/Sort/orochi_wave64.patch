 #else
 			__ballot(
 #endif
@@ -473,31 +476,31 @@ __device__ __forceinline__ void OnesweepReorder( RADIX_SORT_KEY_TYPE* inputKeys,
 		for( int j = 0; j < N_RADIX; ++j )
 		{
 			u32 bit = ( bucketIndex >> j ) & 0x1;
-			u32 difference = ( 0xFFFFFFFF * bit ) ^
+			u64 difference = ( bit ? ~0ull : 0ull ) ^
 #if defined( ITS )
-								__ballot_sync( 0xFFFFFFFF, bit != 0 );
+								__ballot_sync( ~0ull, bit != 0 );
 #else
 								__ballot( bit != 0 );
 #endif
 			broThreads &= ~difference;
 		}
 
-		u32 lowerMask = ( 1u << lane ) - 1;
+		u64 lowerMask = ( (u64)1 << lane ) - 1;
 		auto digitCount = smem.u.phase1.lpSum[bucketIndex * REORDER_NUMBER_OF_WARPS + warp];
-		warpOffsets[k] = digitCount + __popc( broThreads & lowerMask );
+		warpOffsets[k] = digitCount + __popcll( broThreads & lowerMask );
 		
 #if defined( ITS )
-		__syncwarp( 0xFFFFFFFF );
+		__syncwarp( ~0ull );
 #else
 		__syncthreads();
