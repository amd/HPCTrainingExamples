@@ -98,6 +98,116 @@ echo "rocbudai-airgap-check — verify the cluster airgap baseline is in force"
 printf "host: %s   user: %s   date: %s\n" "$(hostname)" "${USER:-?}" "$(date -Is)"
 echo "──────────────────────────────────────────────────────────"
 
+# --- AIM backend airgap verification (HPCTrainingExamples overlay) -----------
+# When the model is served by AIM (ROCBUDAI_BACKEND=aim, or an endpoint is set),
+# the invariants differ from the ollama path: the model runs in-cluster, so we
+# verify the endpoint is in-boundary, opencode is locked down, phone-home is
+# suppressed, host egress (advisory), and (deep) the predictor is not publicly
+# exposed. We run those and skip the ollama/Slurm sections below.
+if [[ "${ROCBUDAI_BACKEND:-ollama}" == "aim" || -n "${ROCBUDAI_AIM_ENDPOINT:-}" ]]; then
+    ep="${ROCBUDAI_AIM_ENDPOINT:-http://localhost:${ROCBUDAI_AIM_LOCAL_PORT:-8088}/v1}"
+    ep="${ep%/}"
+
+    echo "1. Trust assertion"
+    if [[ "${ROCBUDAI_AIM_TRUSTED:-0}" == "1" ]]; then
+        ok "site asserts a trusted, in-boundary cluster (ROCBUDAI_AIM_TRUSTED=1)"
+    else
+        fail "ROCBUDAI_AIM_TRUSTED is not 1 — the launcher will refuse to start."
+        hint "re-run install-rocbudai-aim.sh --trust only if the cluster is genuinely trusted + internet-severed."
+    fi
+    echo
+
+    echo "2. Endpoint is in-boundary"
+    host="$(printf '%s' "$ep" | sed -E 's#^[a-z]+://##; s#[:/].*$##')"
+    if ROCBUDAI_AIM_HOST="$host" python3 - <<'PY'
+import ipaddress, os, socket, sys
+host = os.environ["ROCBUDAI_AIM_HOST"]
+if host == "localhost":
+    sys.exit(0)
+try:
+    addrs = {i[4][0] for i in socket.getaddrinfo(host, None)}
+except Exception:
+    sys.exit(1)
+for a in addrs:
+    ip = ipaddress.ip_address(a)
+    if not (ip.is_loopback or ip.is_private):
+        sys.exit(1)
+sys.exit(0 if addrs else 1)
+PY
+    then
+        ok "endpoint host '${host}' is loopback / RFC1918 (in-boundary)"
+    else
+        fail "endpoint host '${host}' is not in-boundary — code/prompts could leave the cluster."
+        hint "point at a ClusterIP via port-forward, or an internal (RFC1918) address."
+    fi
+    echo
+
+    echo "3. Model endpoint reachable"
+    if curl -fsS --max-time 5 "${ep}/models" >/dev/null 2>&1; then
+        model="$(curl -fsS --max-time 5 "${ep}/models" 2>/dev/null | tr ',' '\n' | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
+        ok "AIM endpoint reachable at ${ep} (model ${model:-?})"
+    else
+        warn "AIM endpoint ${ep} not reachable now (start the port-forward / module load first)."
+    fi
+    echo
+
+    echo "4. opencode lockdown"
+    for v in AUTOUPDATE LSP_DOWNLOAD MODELS_FETCH EXTERNAL_SKILLS SHARE; do
+        eval "val=\${OPENCODE_DISABLE_${v}:-}"
+        if [[ "$val" == "1" ]]; then
+            ok "OPENCODE_DISABLE_${v}=1"
+        else
+            warn "OPENCODE_DISABLE_${v} not set (load the rocbudai module to set it)."
+        fi
+    done
+    if [[ -f opencode.json ]] && grep -q '"share"[[:space:]]*:[[:space:]]*"disabled"' opencode.json 2>/dev/null; then
+        ok "project opencode.json has share: disabled"
+    else
+        hint "run from a session dir (with opencode.json) to verify share:disabled."
+    fi
+    echo
+
+    echo "5. Host egress (advisory)"
+    if curl -fsS --max-time 3 -o /dev/null --head https://huggingface.co/ 2>/dev/null; then
+        warn "this host can reach the public internet; the airgap relies on the cluster being severed, not host-level blocking."
+    else
+        ok "this host cannot reach https://huggingface.co/ (egress restricted)."
+    fi
+    echo
+
+    if [[ $DEEP -eq 1 ]]; then
+        echo "6. Predictor not publicly exposed (deep, needs kubectl)"
+        if command -v kubectl >/dev/null 2>&1 && [[ -n "${ROCBUDAI_AIM_NAMESPACE:-}" ]]; then
+            svc_types="$(kubectl get svc -n "${ROCBUDAI_AIM_NAMESPACE}" -l component=predictor -o jsonpath='{.items[*].spec.type}' --request-timeout=10s 2>/dev/null || true)"
+            if [[ -z "$svc_types" ]]; then
+                warn "no predictor Service found in namespace '${ROCBUDAI_AIM_NAMESPACE}'."
+            elif [[ "$svc_types" == *LoadBalancer* || "$svc_types" == *NodePort* ]]; then
+                fail "predictor Service type is '${svc_types}' — publicly reachable types break the in-boundary assumption."
+            else
+                ok "predictor Service type is '${svc_types}' (ClusterIP — in-cluster only)."
+            fi
+        else
+            hint "set ROCBUDAI_AIM_NAMESPACE and authenticate kubectl for the deep check."
+        fi
+        echo
+    else
+        hint "(re-run with --deep to check the predictor Service is ClusterIP via kubectl)"
+        echo
+    fi
+
+    echo "──────────────────────────────────────────────────────────"
+    echo "Summary:  ${C_OK}${PASS} pass${C_RST}   ${C_FAIL}${FAIL} fail${C_RST}   ${C_WARN}${WARN} warn${C_RST}"
+    echo
+    if [[ $FAIL -gt 0 ]]; then
+        echo "${C_FAIL}One or more AIM airgap checks FAILED — the in-boundary promise is degraded.${C_RST}"
+        exit 1
+    fi
+    echo "The AIM airgap baseline appears intact: the model is served from an in-boundary"
+    echo "endpoint, opencode phone-home is suppressed, and sharing is disabled. Code,"
+    echo "prompts, and model responses stay within the trusted cluster boundary."
+    exit 0
+fi
