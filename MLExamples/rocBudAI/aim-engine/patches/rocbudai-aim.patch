diff --git a/bin/rocbudai-tui b/bin/rocbudai-tui
index dd89a8b..92e5bef 100755
--- a/bin/rocbudai-tui
+++ b/bin/rocbudai-tui
@@ -111,6 +111,205 @@ err() { echo "[rocbudai-tui] error: $*" >&2; }
 warn() { echo "[rocbudai-tui] warning: $*" >&2; }
 info() { echo "[rocbudai-tui] $*"; }
 
+# --- AIM backend (HPCTrainingExamples overlay) -------------------------------
+# With ROCBUDAI_BACKEND=aim we serve the model from an AIM Engine endpoint
+# (OpenAI-compatible vLLM on a trusted, in-boundary Kubernetes cluster) instead
+# of a local ollama daemon. The session picker, naming, banner, resume, and
+# rocbudai-submit paths are reused unchanged; only model resolution, the
+# opencode provider config, and the launch call differ.
+ROCBUDAI_BACKEND="${ROCBUDAI_BACKEND:-ollama}"
+ROCBUDAI_AIM_ENDPOINT="${ROCBUDAI_AIM_ENDPOINT:-}"
+ROCBUDAI_AIM_NAMESPACE="${ROCBUDAI_AIM_NAMESPACE:-}"
+ROCBUDAI_AIM_SERVICE="${ROCBUDAI_AIM_SERVICE:-}"
+ROCBUDAI_AIM_LOCAL_PORT="${ROCBUDAI_AIM_LOCAL_PORT:-8088}"
+ROCBUDAI_AIM_REMOTE_PORT="${ROCBUDAI_AIM_REMOTE_PORT:-80}"
+ROCBUDAI_AIM_TRUSTED="${ROCBUDAI_AIM_TRUSTED:-0}"
+_ROCBUDAI_AIM_MIN_CONTEXT=65536
+_ROCBUDAI_AIM_PF_PID=""
+
+aim_active()  { [[ "${ROCBUDAI_BACKEND}" == "aim" ]]; }
+aim_cleanup() { [[ -n "${_ROCBUDAI_AIM_PF_PID}" ]] && { kill "${_ROCBUDAI_AIM_PF_PID}" >/dev/null 2>&1; pkill -f "port-forward -n ${ROCBUDAI_AIM_NAMESPACE} svc/[^ ]* ${ROCBUDAI_AIM_LOCAL_PORT}:${ROCBUDAI_AIM_REMOTE_PORT}" >/dev/null 2>&1; } || true; }
+
+# Return 0 if HOST is loopback or an RFC1918 private address (in-boundary).
+aim_host_in_boundary() {
+    ROCBUDAI_AIM_HOST="$1" python3 - <<'PY'
+import ipaddress, os, socket, sys
+host = os.environ["ROCBUDAI_AIM_HOST"]
+if host == "localhost":
+    sys.exit(0)
+try:
+    addrs = {i[4][0] for i in socket.getaddrinfo(host, None)}
+except Exception:
+    sys.exit(1)
+for a in addrs:
+    ip = ipaddress.ip_address(a)
+    if not (ip.is_loopback or ip.is_private):
+        sys.exit(1)
+sys.exit(0 if addrs else 1)
+PY
+}
+
+# Refuse unless the site has asserted this is a trusted, in-boundary cluster.
+aim_trust_gate() {
+    if [[ "${ROCBUDAI_AIM_TRUSTED}" != "1" ]]; then
+        err "AIM backend refused: this cluster has not been asserted trusted."
+        err "rocBudAI over AIM only runs against a trusted, in-boundary cluster"
+        err "(your own AMD GPUs, internet-severed). Re-run install-rocbudai-aim.sh"
+        err "with --trust only if that genuinely holds."
+        exit 1
+    fi
+}
+
+# Resolve the AIM endpoint (direct URL or kubectl port-forward), verify it is
+# in-boundary, then read the served model id + context window from /v1/models.
+aim_preflight() {
+    local endpoint="${ROCBUDAI_AIM_ENDPOINT%/}"
+    if [[ -z "${endpoint}" ]]; then
+        command -v kubectl >/dev/null 2>&1 || { err "kubectl not found and no ROCBUDAI_AIM_ENDPOINT set."; exit 1; }
+        [[ -n "${ROCBUDAI_AIM_NAMESPACE}" ]] || { err "set ROCBUDAI_AIM_ENDPOINT or ROCBUDAI_AIM_NAMESPACE."; exit 1; }
+        local svc="${ROCBUDAI_AIM_SERVICE}"
+        if [[ -z "${svc}" ]]; then
+            svc="$(kubectl get svc -n "${ROCBUDAI_AIM_NAMESPACE}" -l component=predictor -o name --request-timeout=10s 2>/dev/null | head -n1 | cut -d/ -f2 || true)"
+            [[ -n "${svc}" ]] || svc="$(kubectl get svc -n "${ROCBUDAI_AIM_NAMESPACE}" -o name --request-timeout=10s 2>/dev/null | grep -m1 predictor | cut -d/ -f2 || true)"
+        fi
+        if [[ -z "${svc}" ]]; then
+            err "no predictor Service found in namespace '${ROCBUDAI_AIM_NAMESPACE}'."
+            err "is kubectl authenticated? try:  kubectl get svc -n ${ROCBUDAI_AIM_NAMESPACE}"
+            exit 1
+        fi
+        info "AIM: port-forwarding svc/${svc} ${ROCBUDAI_AIM_LOCAL_PORT}->${ROCBUDAI_AIM_REMOTE_PORT} (ns ${ROCBUDAI_AIM_NAMESPACE})"
+        endpoint="http://localhost:${ROCBUDAI_AIM_LOCAL_PORT}/v1"
+        ( while :; do kubectl port-forward -n "${ROCBUDAI_AIM_NAMESPACE}" "svc/${svc}" "${ROCBUDAI_AIM_LOCAL_PORT}:${ROCBUDAI_AIM_REMOTE_PORT}" >/dev/null 2>&1 || true; sleep 1; done ) &
+        _ROCBUDAI_AIM_PF_PID=$!
+        trap aim_cleanup EXIT
+        local i ok=""
+        for i in $(seq 1 12); do
+            sleep 1
+            if curl -fsS --max-time 3 "${endpoint}/models" >/dev/null 2>&1; then ok=1; break; fi
+        done
+        [[ -n "${ok}" ]] || { err "AIM endpoint not reachable via port-forward (check kubectl auth / namespace / service)."; exit 1; }
+    fi
+
+    local host
+    host="$(printf '%s' "${endpoint}" | sed -E 's#^[a-z]+://##; s#[:/].*$##')"
+    if ! aim_host_in_boundary "${host}"; then
+        err "AIM endpoint '${endpoint}' does not resolve to an in-boundary address"
+        err "(loopback or RFC1918). Refusing: code and prompts must stay in your cluster."
+        exit 1
+    fi
+
+    local models_json model_id ctx
+    models_json="$(curl -fsS --max-time 10 "${endpoint}/models" 2>/dev/null || true)"
+    [[ -n "${models_json}" ]] || { err "empty response from ${endpoint}/models."; exit 1; }
+    model_id="$(printf '%s' "${models_json}" | tr ',' '\n' | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1 || true)"
+    [[ -n "${model_id}" ]] || { err "could not parse a model id from ${endpoint}/models."; exit 1; }
+    ctx="$(printf '%s' "${models_json}" | tr ',' '\n' | sed -n 's/.*"max_model_len"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' | head -n1 || true)"
+
+    ROCBUDAI_AIM_RESOLVED_ENDPOINT="${endpoint}"
+    ROCBUDAI_AIM_CONTEXT="${ctx}"
+    ROCBUDAI_MODEL="${model_id}"
+    ROCBUDAI_ALLOWED_MODELS="${model_id}"
+    info "AIM: model '${model_id}' via ${endpoint}"
+    if [[ -n "${ctx}" && "${ctx}" -lt "${_ROCBUDAI_AIM_MIN_CONTEXT}" ]]; then
+        warn "AIM: served context ${ctx} < ${_ROCBUDAI_AIM_MIN_CONTEXT}; the full persona (~28k tokens) may not fit."
+    fi
+}
+
+# A usable local GPU means the agent can run locally; without one, opencode's
+# instructions get the no-GPU addendum so GPU work is dispatched via Slurm.
+aim_has_local_gpu() {
+    [[ -e /dev/kfd ]] && return 0
+    command -v rocminfo >/dev/null 2>&1 && rocminfo 2>/dev/null | grep -q 'gfx'
+}
+
+aim_persona_file_for() {
+    case "$1" in
+        gfx90a)        echo "AGENTS-gfx90a.md" ;;
+        gfx942|mi300x) echo "AGENTS-gfx942-mi300x.md" ;;
+        gfx950)        echo "AGENTS-gfx950.md" ;;
+        mi300a)        echo "AGENTS-default.md" ;;
+        *)             echo "" ;;
+    esac
+}
+
+# The agent host has no local GPU to autodetect from, so the profiling target
+# is asked, not detected. An existing session AGENTS.md is reused (resume), and
+# ROCBUDAI_GFX_ARCH short-circuits the prompt for non-interactive use.
+aim_pick_arch() {
+    if [[ -f AGENTS.md ]]; then
+        ROCBUDAI_AGENTS_TEMPLATE="$(pwd)/AGENTS.md"
+        return
+    fi
+    local arch="${ROCBUDAI_GFX_ARCH:-}"
+    if [[ -z "${arch}" ]]; then
+        echo "This host has no local GPU, so the profiling target cannot be detected." >&2
+        echo "Which AMD GPU are you profiling on the compute nodes?" >&2
+        echo "  1) MI250X / MI210    (gfx90a)" >&2
+        echo "  2) MI300X            (mi300x)" >&2
+        echo "  3) MI355X / MI350X   (gfx950)" >&2
+        echo "  4) MI300A APU        (mi300a)" >&2
+        local choice=""
+        while :; do
+            printf "select [1-4]: " >&2
+            read -r choice || choice=""
+            case "${choice}" in
+                1) arch=gfx90a; break ;;
+                2) arch=mi300x; break ;;
+                3) arch=gfx950; break ;;
+                4) arch=mi300a; break ;;
+                *) echo "  please enter 1, 2, 3, or 4." >&2 ;;
+            esac
+        done
+    fi
+    local persona; persona="$(aim_persona_file_for "${arch}")"
+    [[ -n "${persona}" ]] || { warn "unknown ROCBUDAI_GFX_ARCH='${arch}'; using the gfx950 persona."; persona="AGENTS-gfx950.md"; }
+    ROCBUDAI_AGENTS_TEMPLATE="${ROCBUDAI_SHARE}/${persona}"
+    info "AIM: ${arch} profiling target (${persona})"
+}
+
+# Write opencode.json for the AIM provider from the stock template (so the
+# permission block and share:disabled are inherited), injecting the provider,
+# the aim/<id> model, and absolute instruction paths.
+aim_write_opencode_json() {
+    ROCBUDAI_T="$1" ROCBUDAI_O="$2" ROCBUDAI_EP="$3" ROCBUDAI_M="$4" \
+    ROCBUDAI_AG="$5" ROCBUDAI_ADD="$6" ROCBUDAI_CTX="$7" python3 - <<'PY'
+import json, os
+tpl = json.load(open(os.environ["ROCBUDAI_T"]))
+model = os.environ["ROCBUDAI_M"]
+tpl["model"] = f"aim/{model}"
+tpl["small_model"] = f"aim/{model}"
+# The AIM model is served by a custom provider opencode has no models.dev
+# metadata for (unlike the stock ollama model, whose limits opencode already
+# knows). Declare the served window (max_model_len) so opencode's auto-compaction
+# and output-token cap engage; without a limit it can send a negative max_tokens
+# once the context fills and vLLM rejects with "max_tokens must be at least 1".
+entry = {"name": model}
+ctx = os.environ.get("ROCBUDAI_CTX", "")
+if ctx.isdigit() and int(ctx) > 0:
+    n = int(ctx)
+    entry["limit"] = {"context": n, "output": min(32768, max(4096, n // 4))}
+tpl["provider"] = {
+    "aim": {
+        "npm": "@ai-sdk/openai-compatible",
+        "name": "AIM Engine",
+        "options": {"baseURL": os.environ["ROCBUDAI_EP"]},
+        "models": {model: entry},
+    }
+}
+instr = [os.environ["ROCBUDAI_AG"]]
+add = os.environ.get("ROCBUDAI_ADD", "")
+if add:
+    instr.append(add)
+tpl["instructions"] = instr
+json.dump(tpl, open(os.environ["ROCBUDAI_O"], "w"), indent=2)
+PY
+}
+
+if aim_active; then
+    aim_trust_gate
+    aim_preflight
+fi
